@using UI.Models

<div class="card h-100">
    <div class="card-header fw-semibold">
        @Title
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Путь к файлу</label>
            <input class="form-control"
                   @bind="Settings.FilePath" />
        </div>

        <div class="mb-3">
            <label class="form-label">Тип файла</label>

            <select class="form-select" @bind="Settings.FileType">
                <option value="Csv">CSV</option>
                <option value="Json">JSON</option>
                <option value="Xml">XML</option>
            </select>
        </div>

        <div class="form-check form-switch mb-3">
            <input class="form-check-input"
                   type="checkbox"
                   id="@($"enabled-{EntityType}")"
                   @bind="Settings.IsEnabled" />

            <label class="form-check-label"
                   for="@($"enabled-{EntityType}")">
                Импорт включён
            </label>
        </div>

        <div class="text-muted small mb-3">
            Расписание:
            @(Settings.Schedule.IsEnabled
                        ? $"включено, {Settings.Schedule.RepeatIntervalSeconds} сек."
                        : "не настроено")
        </div>
    </div>

    <div class="card-footer d-flex justify-content-between">
        <Button Color="ButtonColor.Primary"
                Size="ButtonSize.Small"
                @onclick="OnScheduleClicked">
            Расписание
        </Button>

        <Button Color="ButtonColor.Warning"
                Size="ButtonSize.Small"
                @onclick="OnImportClicked">
            Загрузить сейчас
        </Button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string EntityType { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public ImportSettings Settings { get; set; } = new();

    [Parameter]
    public EventCallback OnScheduleClicked { get; set; }

    [Parameter]
    public EventCallback OnImportClicked { get; set; }
}