@page "/stocks"
@rendermode InteractiveServer
@using UI.Models
@using UI.Components.Shared
@inject ApiClient Api

<PageTitle>Остатки</PageTitle>

<h1>Остатки</h1>

<div class="toolbar">
    <div class="d-flex gap-3 flex-wrap align-items-end">
        <div style="min-width: 280px;">
            <ProductSelect Products="products"
                           Value="@selectedProductId"
                           ValueChanged="OnProductSelectedAsync" />
        </div>

        <div style="min-width: 220px;">
            <BranchSelect Branches="branches"
                          IncludeAll="true"
                          Value="@selectedBranchId"
                          ValueChanged="OnBranchSelectedAsync" />
        </div>
    </div>

    <Button Color="ButtonColor.Primary"
            @onclick="OpenCreateAsync">
        Добавить
    </Button>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EntityTable TItem="Stock"
             Items="paged.Items"
             Columns="stockColumns"
             KeySelector="x => x.Id"
             @bind-SelectedIds="SelectedIds"
             SortColumn="sortColumn"
             SortAscending="sortAscending"
             SortChanged="OnSortChangedAsync"
             ItemDoubleClicked="OpenEditAsync" />

<Pagination class="mt-3 justify-content-center"
            TotalPages="TotalPages"
            Page="page"
            PageSize="pageSize"
            TotalCount="paged.TotalCount"
            PageChanged="OnPageChangedAsync" />

<EntityEditModal TItem="Stock"
                 @ref="stockModal"
                 Title="@modalTitle"
                 Item="editingStock"
                 FormTemplate="StockForm"
                 OnSave="SaveStockAsync" />

@code {
    private List<EntityColumn<Stock>> stockColumns = [];
    private PagedResult<Stock> paged = new();
    private HashSet<string> SelectedIds = [];
    private List<Product> products = [];
    private List<Branch> branches = [];
    private List<MeasureUnit> units = [];
    private string selectedBranchId = string.Empty;

    private EntityEditModal<Stock> stockModal = default!;
    private Stock editingStock = new();
    private string modalTitle = "Новый остаток";

    private string selectedProductId = string.Empty;
    private string? errorMessage;

    private int page = 1;
    private int pageSize = 20;
    private EntityColumn<Stock>? sortColumn;
    private bool sortAscending = true;

    private int TotalPages =>
        pageSize == 0 ? 0 : (int)Math.Ceiling(paged.TotalCount / (double)pageSize);

    protected override void OnInitialized()
    {
        stockColumns =
        [
            new EntityColumn<Stock>
            {
                Name = "Product",
                Header = "Товар",
                Width = 4,
                ValueSelector = stock => stock.ProductId,
                CellTemplate = stock => @<span>@GetProductName(stock.ProductId)</span>
            },

            new EntityColumn<Stock>
            {
                Name = nameof(Stock.BranchId),
                Header = "Филиал",
                Width = 2,
                ValueSelector = stock => stock.BranchId,
                CellTemplate = stock => @<span>@GetBranchName(stock.BranchId)</span>
            },

            new EntityColumn<Stock>
            {
                Name = nameof(Stock.Quantity),
                Header = "Количество",
                Width = 2,
                ValueSelector = stock => stock.Quantity,
                CellTemplate = stock => @<span>@stock.Quantity @GetUnitName(stock.ProductId)</span>
            },

            new EntityColumn<Stock>
            {
                Name = nameof(Stock.Reserve),
                Header = "Резерв",
                Width = 2,
                ValueSelector = stock => stock.Reserve,
                CellTemplate = stock => @<span>@stock.Reserve</span>
            },

            new EntityColumn<Stock>
            {
                Name = nameof(Stock.Transit),
                Header = "В пути",
                Width = 2,
                ValueSelector = stock => stock.Transit,
                CellTemplate = stock => @<span>@stock.Transit</span>
            }
        ];
        sortColumn = stockColumns.First(x => x.Name == nameof(Stock.Quantity));
        sortAscending = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
        await LoadAsync();
    }

    private async Task LoadProductsAsync()
    {
        products = await Api.GetAll<Product>("api/products");
        branches = await Api.GetAll<Branch>("api/branches");
        units = await Api.GetAll<MeasureUnit>("api/units");
    }

    private string GetProductName(string productId)
    {
        return products.FirstOrDefault(x => x.Id == productId)?.Name ?? "—";
    }

    private string GetBranchName(string branchId)
    {
        return branches.FirstOrDefault(x => x.Id == branchId)?.Name ?? "—";
    }

    private string GetUnitName(string productId)
    {
        var unitId = products.FirstOrDefault(x => x.Id == productId)?.UnitId;

        return units.FirstOrDefault(x => x.Id == unitId)?.DisplayName ?? "шт.";
    }

    private async Task OnBranchSelectedAsync(string branchId)
    {
        selectedBranchId = branchId;
        page = 1;

        await LoadAsync();
    }

    private RenderFragment<Stock> StockForm => stock => @<div>
        <div class="row g-3">
            <div class="col-md-6">
                <ProductSelect Products="products"
                               @bind-Value="stock.ProductId" />
            </div>

            <div class="col-md-6">
                <BranchSelect Branches="branches"
                              @bind-Value="stock.BranchId" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Количество</label>
                <input class="form-control"
                       type="number"
                       @bind="stock.Quantity" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Резерв</label>
                <input class="form-control"
                       type="number"
                       @bind="stock.Reserve" />
            </div>

            <div class="col-md-6">
                <label class="form-label">В пути</label>
                <input class="form-control"
                       type="number"
                       @bind="stock.Transit" />
            </div>
        </div>
    </div>;

    private async Task LoadAsync()
    {
        try
        {
            paged = await Api.GetPaged<Stock>(
                "api/stocks",
                page,
                pageSize,
                selectedProductId,
                sortColumn?.Name,
                !sortAscending,
                selectedBranchId);

            SelectedIds = [];
            errorMessage = null;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Не удалось загрузить остатки. Проверьте подключение к API.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task OnProductSelectedAsync(string productId)
    {
        selectedProductId = productId;
        page = 1;

        await LoadAsync();
    }

    private async Task OnSortChangedAsync(EntityColumn<Stock> column)
    {
        if (sortColumn?.Name == column.Name)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int newPage)
    {
        page = newPage;

        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        modalTitle = "Новый остаток";
        editingStock = new Stock
        {
            BranchId = string.IsNullOrWhiteSpace(selectedBranchId) ? Branch.DefaultId : selectedBranchId
        };

        await stockModal.ShowAsync(editingStock);
    }

    private async Task OpenEditAsync(Stock stock)
    {
        modalTitle = "Редактирование остатка";

        editingStock = new Stock
        {
            Id = stock.Id,
            ProductId = stock.ProductId,
            BranchId = stock.BranchId,
            Quantity = stock.Quantity,
            Reserve = stock.Reserve,
            Transit = stock.Transit
        };

        await stockModal.ShowAsync(editingStock);
    }

    private async Task SaveStockAsync(Stock stock)
    {
        if (string.IsNullOrWhiteSpace(stock.ProductId))
        {
            throw new InvalidOperationException("ID товара обязательно.");
        }

        if (string.IsNullOrWhiteSpace(stock.Id))
        {
            await Api.Create("api/stocks", stock);
        }
        else
        {
            await Api.Update("api/stocks", stock.Id, stock);
        }

        await LoadAsync();
    }
}