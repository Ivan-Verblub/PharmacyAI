@page "/branches"
@rendermode InteractiveServer
@using UI.Models
@using UI.Components.Shared
@inject ApiClient Api

<PageTitle>Филиалы</PageTitle>

<h1>Филиалы</h1>

<div class="toolbar">
    <input class="form-control w-auto"
           placeholder="Поиск по названию или коду"
           @bind="search"
           @bind:after="ApplySearchAsync" />

    <div class="d-flex gap-2">
        <Button Color="ButtonColor.Secondary"
                Disabled="@(SelectedIds.Count == 0)"
                @onclick="DeleteSelectedAsync">
            Удалить
        </Button>

        <Button Color="ButtonColor.Primary"
                @onclick="OpenCreateAsync">
            Добавить
        </Button>
    </div>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EntityTable TItem="Branch"
             Items="paged.Items"
             Columns="columns"
             KeySelector="x => x.Id"
             @bind-SelectedIds="SelectedIds"
             SortColumn="sortColumn"
             SortAscending="sortAscending"
             SortChanged="OnSortChangedAsync"
             ItemDoubleClicked="OpenEditAsync" />

<Pagination class="mt-3 justify-content-center"
            TotalPages="TotalPages"
            Page="page"
            PageSize="pageSize"
            TotalCount="paged.TotalCount"
            PageChanged="OnPageChangedAsync" />

<EntityEditModal TItem="Branch"
                 @ref="modal"
                 Title="@modalTitle"
                 Item="editing"
                 FormTemplate="BranchForm"
                 OnSave="SaveAsync" />

@code {
    private List<EntityColumn<Branch>> columns = [];
    private PagedResult<Branch> paged = new();
    private HashSet<string> SelectedIds = [];

    private EntityEditModal<Branch> modal = default!;
    private Branch editing = new();
    private string modalTitle = "Новый филиал";

    private string search = string.Empty;
    private string appliedSearch = string.Empty;
    private string? errorMessage;

    private int page = 1;
    private int pageSize = 20;
    private EntityColumn<Branch>? sortColumn;
    private bool sortAscending = true;

    private int TotalPages =>
        pageSize == 0 ? 0 : (int)Math.Ceiling(paged.TotalCount / (double)pageSize);

    protected override void OnInitialized()
    {
        columns =
        [
            new EntityColumn<Branch>
            {
                Name = nameof(Branch.Code),
                Header = "Код",
                Width = 2,
                ValueSelector = x => x.Code,
                CellTemplate = x => @<span>@x.Code</span>
            },
            new EntityColumn<Branch>
            {
                Name = nameof(Branch.Name),
                Header = "Наименование",
                Width = 4,
                ValueSelector = x => x.Name,
                CellTemplate = x => @<span>@x.Name</span>
            },
            new EntityColumn<Branch>
            {
                Name = nameof(Branch.Address),
                Header = "Адрес",
                Width = 4,
                ValueSelector = x => x.Address,
                CellTemplate = x => @<span>@x.Address</span>
            },
            new EntityColumn<Branch>
            {
                Name = nameof(Branch.IsActive),
                Header = "Статус",
                Width = 2,
                ValueSelector = x => x.IsActive,
                CellTemplate = x => @<span class="badge @(x.IsActive ? "badge-brand" : "bg-secondary")">@(x.IsActive ? "Активен" : "Не активен")</span>
            }
        ];

        sortColumn = columns.First(x => x.Name == nameof(Branch.Name));
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private RenderFragment<Branch> BranchForm => branch => @<div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Код</label>
            <input class="form-control" @bind="branch.Code" />
        </div>
        <div class="col-md-8">
            <label class="form-label">Наименование</label>
            <input class="form-control" @bind="branch.Name" />
        </div>
        <div class="col-12">
            <label class="form-label">Адрес</label>
            <input class="form-control" @bind="branch.Address" />
        </div>
        <div class="col-12">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="branchActive" @bind="branch.IsActive" />
                <label class="form-check-label" for="branchActive">Участвует в анализе закупок</label>
            </div>
        </div>
    </div>;

    private async Task LoadAsync()
    {
        try
        {
            paged = await Api.GetPaged<Branch>(
                "api/branches",
                page,
                pageSize,
                appliedSearch,
                sortColumn?.Name,
                !sortAscending);

            SelectedIds = [];
            errorMessage = null;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Не удалось загрузить филиалы. Проверьте подключение к API.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task ApplySearchAsync()
    {
        appliedSearch = search;
        page = 1;

        await LoadAsync();
    }

    private async Task OnSortChangedAsync(EntityColumn<Branch> column)
    {
        if (sortColumn?.Name == column.Name)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int newPage)
    {
        page = newPage;

        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        modalTitle = "Новый филиал";
        editing = new Branch();

        await modal.ShowAsync(editing);
    }

    private async Task OpenEditAsync(Branch branch)
    {
        modalTitle = "Редактирование филиала";

        editing = new Branch
        {
            Id = branch.Id,
            Code = branch.Code,
            Name = branch.Name,
            Address = branch.Address,
            IsActive = branch.IsActive
        };

        await modal.ShowAsync(editing);
    }

    private async Task SaveAsync(Branch branch)
    {
        if (string.IsNullOrWhiteSpace(branch.Name))
        {
            throw new InvalidOperationException("Наименование филиала обязательно.");
        }

        if (string.IsNullOrWhiteSpace(branch.Id))
        {
            await Api.Create("api/branches", branch);
        }
        else
        {
            await Api.Update("api/branches", branch.Id, branch);
        }

        await LoadAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        try
        {
            await Api.DeleteMany("api/branches", SelectedIds);
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.Message;
        }
    }
}
