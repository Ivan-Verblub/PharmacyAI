@page "/products"
@rendermode InteractiveServer
@using UI.Models
@using UI.Components.Shared
@inject ApiClient Api

<PageTitle>Товары</PageTitle>

<h1>Товары</h1>

<div class="toolbar">
    <input class="form-control w-auto"
           placeholder="Поиск по названию"
           @bind="search"
           @bind:after="ApplySearchAsync" />

    <Button Color="ButtonColor.Primary"
            @onclick="OpenCreateAsync">
        Добавить
    </Button>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EntityTable TItem="Product"
             Items="paged.Items"
             Columns="productColumns"
             KeySelector="x => x.Id"
             @bind-SelectedIds="SelectedIds"
             SortColumn="sortColumn"
             SortAscending="sortAscending"
             SortChanged="OnSortChangedAsync"
             ItemDoubleClicked="OpenEditAsync" />

<Pagination class="mt-3 justify-content-center"
            TotalPages="TotalPages"
            Page="page"
            PageSize="pageSize"
            TotalCount="paged.TotalCount"
            PageChanged="OnPageChangedAsync" />

<EntityEditModal TItem="Product"
                 @ref="productModal"
                 Title="@modalTitle"
                 Item="editingProduct"
                 FormTemplate="ProductForm"
                 OnSave="SaveProductAsync" />

@code {
    private List<EntityColumn<Product>> productColumns = [];
    private PagedResult<Product> paged = new();
    private List<MeasureUnit> units = [];
    private HashSet<string> SelectedIds = [];

    private EntityEditModal<Product> productModal = default!;
    private Product editingProduct = new();
    private string modalTitle = "Новый товар";

    private string search = string.Empty;
    private string appliedSearch = string.Empty;
    private string? errorMessage;

    private int page = 1;
    private int pageSize = 20;
    private EntityColumn<Product>? sortColumn;
    private bool sortAscending = true;

    private int TotalPages =>
        pageSize == 0 ? 0 : (int)Math.Ceiling(paged.TotalCount / (double)pageSize);

    protected override void OnInitialized()
    {
        productColumns =
        [
            new EntityColumn<Product>
            {
                Name = nameof(Product.Name),
                Header = "Название",
                Width = 4,
                ValueSelector = product => product.Name,
                CellTemplate = product => @<span>@product.Name</span>
            },

            new EntityColumn<Product>
            {
                Name = nameof(Product.DeliveryDays),
                Header = "Доставка, дн.",
                Width = 2,
                ValueSelector = product => product.DeliveryDays,
                CellTemplate = product => @<span>@product.DeliveryDays</span>
            },

            new EntityColumn<Product>
            {
                Name = nameof(Product.StorageLife),
                Header = "Срок хранения, дн.",
                Width = 2,
                ValueSelector = product => product.StorageLife,
                CellTemplate = product => @<span>@product.StorageLife</span>
            },

            new EntityColumn<Product>
            {
                Name = nameof(Product.UnitId),
                Header = "Ед. изм. / закупки",
                Width = 2,
                ValueSelector = product => product.UnitId,
                CellTemplate = product => @<span>@GetUnitName(product.UnitId)@(product.PurchaseUnitRatio > 1 ? $" / {GetUnitName(product.PurchaseUnitId ?? product.UnitId)} ×{product.PurchaseUnitRatio}" : string.Empty)</span>
            },

            new EntityColumn<Product>
            {
                Name = nameof(Product.MinPurchaseQuantity),
                Header = "Мин. закупка",
                Width = 2,
                ValueSelector = product => product.MinPurchaseQuantity,
                CellTemplate = product => @<span>@(product.MinPurchaseQuantity > 0 ? $"{product.MinPurchaseQuantity} {GetUnitName(product.UnitId)}" : "—")</span>
            }
        ];
        sortColumn = productColumns.First(x => x.Name == nameof(Product.Name));
        sortAscending = true;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            units = await Api.GetAll<MeasureUnit>("api/units");
        }
        catch (HttpRequestException ex)
        {
            Console.Error.WriteLine(ex);
        }

        await LoadAsync();
    }

    private string GetUnitName(string? unitId)
    {
        return units.FirstOrDefault(x => x.Id == unitId)?.DisplayName ?? "шт.";
    }

    private RenderFragment<Product> ProductForm => product => @<div>
        <div class="mb-3">
            <label class="form-label">Название</label>
            <input class="form-control"
                   @bind="product.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Дней доставки</label>
            <input class="form-control"
                   type="number"
                   @bind="product.DeliveryDays" />
        </div>

        <div class="mb-3">
            <label class="form-label">Срок хранения, дней</label>
            <input class="form-control"
                   type="number"
                   @bind="product.StorageLife" />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label">Базовая единица измерения</label>
                <select class="form-select" @bind="product.UnitId">
                    @foreach (var unit in units)
                    {
                        <option value="@unit.Id">@unit.Name (@unit.DisplayName)</option>
                    }
                </select>
                <div class="form-text">В ней ведутся движения, остатки и рекомендации.</div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Единица закупки</label>
                <select class="form-select"
                        value="@(product.PurchaseUnitId ?? string.Empty)"
                        @onchange="args => product.PurchaseUnitId = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value!.ToString()">
                    <option value="">Как базовая</option>
                    @foreach (var unit in units)
                    {
                        <option value="@unit.Id">@unit.Name (@unit.DisplayName)</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Базовых единиц в единице закупки</label>
                <input class="form-control"
                       type="number"
                       min="1"
                       @bind="product.PurchaseUnitRatio" />
                <div class="form-text">Итог закупки округляется до кратного.</div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Минимальная обязательная закупка, @GetUnitName(product.UnitId)</label>
            <input class="form-control"
                   type="number"
                   min="0"
                   @bind="product.MinPurchaseQuantity" />
            <div class="form-text">
                Закупается в каждом филиале безусловно — даже при нулевом спросе или достаточном остатке.
                0 — без обязательного минимума.
            </div>
        </div>
    </div>;

    private async Task LoadAsync()
    {
        try
        {
            paged = await Api.GetPaged<Product>(
                "api/products",
                page,
                pageSize,
                appliedSearch,
                sortColumn?.Name,
                !sortAscending);

            SelectedIds = [];
            errorMessage = null;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Не удалось загрузить товары. Проверьте подключение к API.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task ApplySearchAsync()
    {
        appliedSearch = search;
        page = 1;

        await LoadAsync();
    }

    private async Task OnSortChangedAsync(EntityColumn<Product> column)
    {
        if (sortColumn?.Name == column.Name)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int newPage)
    {
        page = newPage;

        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        modalTitle = "Новый товар";
        editingProduct = new Product();

        await productModal.ShowAsync(editingProduct);
    }

    private async Task OpenEditAsync(Product product)
    {
        modalTitle = "Редактирование товара";

        editingProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            DeliveryDays = product.DeliveryDays,
            StorageLife = product.StorageLife,
            UnitId = product.UnitId,
            PurchaseUnitId = product.PurchaseUnitId,
            PurchaseUnitRatio = product.PurchaseUnitRatio,
            MinPurchaseQuantity = product.MinPurchaseQuantity
        };

        await productModal.ShowAsync(editingProduct);
    }

    private async Task SaveProductAsync(Product product)
    {
        if (string.IsNullOrWhiteSpace(product.Name))
        {
            throw new InvalidOperationException("Название товара обязательно.");
        }

        if (product.PurchaseUnitRatio < 1)
        {
            throw new InvalidOperationException("Коэффициент единицы закупки должен быть не меньше 1.");
        }

        if (product.MinPurchaseQuantity < 0)
        {
            throw new InvalidOperationException("Минимальная закупка не может быть отрицательной.");
        }

        if (string.IsNullOrWhiteSpace(product.Id))
        {
            await Api.Create("api/products", product);
        }
        else
        {
            await Api.Update("api/products", product.Id, product);
        }

        await LoadAsync();
    }
}