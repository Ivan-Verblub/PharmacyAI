@page "/products"
@rendermode InteractiveServer
@using UI.Models
@using UI.Components.Shared
@inject ApiClient Api

<PageTitle>Товары</PageTitle>

<h1>Товары</h1>

<div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
    <input class="form-control w-auto"
           placeholder="Поиск по названию"
           @bind="search"
           @bind:after="ApplySearchAsync" />

    <Button Color="ButtonColor.Primary"
            @onclick="OpenCreateAsync">
        Добавить
    </Button>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EntityTable TItem="Product"
             Items="paged.Items"
             Columns="productColumns"
             KeySelector="x => x.Id"
             @bind-SelectedIds="SelectedIds"
             SortColumn="sortColumn"
             SortAscending="sortAscending"
             SortChanged="OnSortChangedAsync"
             ItemDoubleClicked="OpenEditAsync" />

<Pagination class="mt-3 justify-content-center"
            TotalPages="TotalPages"
            Page="page"
            PageSize="pageSize"
            TotalCount="paged.TotalCount"
            PageChanged="OnPageChangedAsync" />

<EntityEditModal TItem="Product"
                 @ref="productModal"
                 Title="@modalTitle"
                 Item="editingProduct"
                 FormTemplate="ProductForm"
                 OnSave="SaveProductAsync" />

@code {
    private List<EntityColumn<Product>> productColumns = [];
    private PagedResult<Product> paged = new();
    private HashSet<string> SelectedIds = [];

    private EntityEditModal<Product> productModal = default!;
    private Product editingProduct = new();
    private string modalTitle = "Новый товар";

    private string search = string.Empty;
    private string appliedSearch = string.Empty;
    private string? errorMessage;

    private int page = 1;
    private int pageSize = 20;
    private EntityColumn<Product>? sortColumn;
    private bool sortAscending = true;

    private int TotalPages =>
        pageSize == 0 ? 0 : (int)Math.Ceiling(paged.TotalCount / (double)pageSize);

    protected override void OnInitialized()
    {
        productColumns =
        [
            new EntityColumn<Product>
            {
                Name = nameof(Product.Name),
                Header = "Название",
                Width = 8,
                ValueSelector = product => product.Name,
                CellTemplate = product => @<span>@product.Name</span>
            },

            new EntityColumn<Product>
            {
                Name = nameof(Product.DeliveryDays),
                Header = "Дней доставки",
                Width = 2,
                ValueSelector = product => product.DeliveryDays,
                CellTemplate = product => @<span>@product.DeliveryDays</span>
            },

            new EntityColumn<Product>
            {
                Name = nameof(Product.StorageLife),
                Header = "Срок хранения",
                Width = 2,
                ValueSelector = product => product.StorageLife,
                CellTemplate = product => @<span>@product.StorageLife</span>
            }
        ];
        sortColumn = productColumns.First(x => x.Name == nameof(Product.Name));
        sortAscending = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private RenderFragment<Product> ProductForm => product => @<div>
        <div class="mb-3">
            <label class="form-label">Название</label>
            <input class="form-control"
                   @bind="product.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Дней доставки</label>
            <input class="form-control"
                   type="number"
                   @bind="product.DeliveryDays" />
        </div>

        <div class="mb-3">
            <label class="form-label">Срок хранения, дней</label>
            <input class="form-control"
                   type="number"
                   @bind="product.StorageLife" />
        </div>
    </div>;

    private async Task LoadAsync()
    {
        try
        {
            paged = await Api.GetPaged<Product>(
                "api/products",
                page,
                pageSize,
                appliedSearch,
                sortColumn.Name,
                sortAscending);

            SelectedIds = [];
            errorMessage = null;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Не удалось загрузить товары. Проверьте подключение к API.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task ApplySearchAsync()
    {
        appliedSearch = search;
        page = 1;

        await LoadAsync();
    }

    private async Task OnSortChangedAsync(EntityColumn<Product> column)
    {
        if (sortColumn?.Name == column.Name)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int newPage)
    {
        page = newPage;

        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        modalTitle = "Новый товар";
        editingProduct = new Product();

        await productModal.ShowAsync(editingProduct);
    }

    private async Task OpenEditAsync(Product product)
    {
        modalTitle = "Редактирование товара";

        editingProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            DeliveryDays = product.DeliveryDays,
            StorageLife = product.StorageLife
        };

        await productModal.ShowAsync(editingProduct);
    }

    private async Task SaveProductAsync(Product product)
    {
        if (string.IsNullOrWhiteSpace(product.Name))
        {
            throw new InvalidOperationException("Название товара обязательно.");
        }

        if (string.IsNullOrWhiteSpace(product.Id))
        {
            await Api.Create("api/products", product);
        }
        else
        {
            await Api.Update("api/products", product.Id, product);
        }

        await LoadAsync();
    }
}