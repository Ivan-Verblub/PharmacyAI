@page "/units"
@rendermode InteractiveServer
@using UI.Models
@using UI.Components.Shared
@inject ApiClient Api

<PageTitle>Единицы измерения</PageTitle>

<h1>Единицы измерения</h1>

<div class="toolbar">
    <input class="form-control w-auto"
           placeholder="Поиск по названию"
           @bind="search"
           @bind:after="ApplySearchAsync" />

    <div class="d-flex gap-2">
        <Button Color="ButtonColor.Secondary"
                Disabled="@(SelectedIds.Count == 0)"
                @onclick="DeleteSelectedAsync">
            Удалить
        </Button>

        <Button Color="ButtonColor.Primary"
                @onclick="OpenCreateAsync">
            Добавить
        </Button>
    </div>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EntityTable TItem="MeasureUnit"
             Items="paged.Items"
             Columns="columns"
             KeySelector="x => x.Id"
             @bind-SelectedIds="SelectedIds"
             SortColumn="sortColumn"
             SortAscending="sortAscending"
             SortChanged="OnSortChangedAsync"
             ItemDoubleClicked="OpenEditAsync" />

<Pagination class="mt-3 justify-content-center"
            TotalPages="TotalPages"
            Page="page"
            PageSize="pageSize"
            TotalCount="paged.TotalCount"
            PageChanged="OnPageChangedAsync" />

<EntityEditModal TItem="MeasureUnit"
                 @ref="modal"
                 Title="@modalTitle"
                 Item="editing"
                 FormTemplate="UnitForm"
                 OnSave="SaveAsync" />

@code {
    private List<EntityColumn<MeasureUnit>> columns = [];
    private PagedResult<MeasureUnit> paged = new();
    private HashSet<string> SelectedIds = [];

    private EntityEditModal<MeasureUnit> modal = default!;
    private MeasureUnit editing = new();
    private string modalTitle = "Новая единица измерения";

    private string search = string.Empty;
    private string appliedSearch = string.Empty;
    private string? errorMessage;

    private int page = 1;
    private int pageSize = 20;
    private EntityColumn<MeasureUnit>? sortColumn;
    private bool sortAscending = true;

    private int TotalPages =>
        pageSize == 0 ? 0 : (int)Math.Ceiling(paged.TotalCount / (double)pageSize);

    protected override void OnInitialized()
    {
        columns =
        [
            new EntityColumn<MeasureUnit>
            {
                Name = nameof(MeasureUnit.Code),
                Header = "Код ОКЕИ",
                Width = 2,
                ValueSelector = x => x.Code,
                CellTemplate = x => @<span>@x.Code</span>
            },
            new EntityColumn<MeasureUnit>
            {
                Name = nameof(MeasureUnit.Name),
                Header = "Наименование",
                Width = 6,
                ValueSelector = x => x.Name,
                CellTemplate = x => @<span>@x.Name</span>
            },
            new EntityColumn<MeasureUnit>
            {
                Name = nameof(MeasureUnit.ShortName),
                Header = "Сокращение",
                Width = 4,
                ValueSelector = x => x.ShortName,
                CellTemplate = x => @<span>@x.ShortName</span>
            }
        ];

        sortColumn = columns.First(x => x.Name == nameof(MeasureUnit.Name));
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private RenderFragment<MeasureUnit> UnitForm => unit => @<div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Код ОКЕИ</label>
            <input class="form-control" @bind="unit.Code" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Наименование</label>
            <input class="form-control" @bind="unit.Name" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Сокращение</label>
            <input class="form-control" @bind="unit.ShortName" />
        </div>
    </div>;

    private async Task LoadAsync()
    {
        try
        {
            paged = await Api.GetPaged<MeasureUnit>(
                "api/units",
                page,
                pageSize,
                appliedSearch,
                sortColumn?.Name,
                !sortAscending);

            SelectedIds = [];
            errorMessage = null;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Не удалось загрузить единицы измерения. Проверьте подключение к API.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task ApplySearchAsync()
    {
        appliedSearch = search;
        page = 1;

        await LoadAsync();
    }

    private async Task OnSortChangedAsync(EntityColumn<MeasureUnit> column)
    {
        if (sortColumn?.Name == column.Name)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int newPage)
    {
        page = newPage;

        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        modalTitle = "Новая единица измерения";
        editing = new MeasureUnit();

        await modal.ShowAsync(editing);
    }

    private async Task OpenEditAsync(MeasureUnit unit)
    {
        modalTitle = "Редактирование единицы измерения";

        editing = new MeasureUnit
        {
            Id = unit.Id,
            Code = unit.Code,
            Name = unit.Name,
            ShortName = unit.ShortName
        };

        await modal.ShowAsync(editing);
    }

    private async Task SaveAsync(MeasureUnit unit)
    {
        if (string.IsNullOrWhiteSpace(unit.Name))
        {
            throw new InvalidOperationException("Наименование единицы измерения обязательно.");
        }

        if (string.IsNullOrWhiteSpace(unit.Id))
        {
            await Api.Create("api/units", unit);
        }
        else
        {
            await Api.Update("api/units", unit.Id, unit);
        }

        await LoadAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        try
        {
            await Api.DeleteMany("api/units", SelectedIds);
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.Message;
        }
    }
}
