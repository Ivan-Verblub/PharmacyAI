@page "/flows"
@rendermode InteractiveServer
@using UI.Models
@using UI.Components.Shared
@inject ApiClient Api

<PageTitle>Движения</PageTitle>

<h1>Движения</h1>

<div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
    <div class="w-auto" style="min-width: 280px;">
        <ProductSelect Products="products"
                       Value="@selectedProductId"
                       ValueChanged="OnProductSelectedAsync" />
    </div>

    <Button Color="ButtonColor.Primary"
            @onclick="OpenCreateAsync">
        Добавить
    </Button>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EntityTable TItem="Flow"
             Items="paged.Items"
             Columns="flowColumns"
             KeySelector="x => x.Id"
             @bind-SelectedIds="SelectedIds"
             SortColumn="sortColumn"
             SortAscending="sortAscending"
             SortChanged="OnSortChangedAsync"
             ItemDoubleClicked="OpenEditAsync" />

<Pagination class="mt-3 justify-content-center"
            TotalPages="TotalPages"
            Page="page"
            PageSize="pageSize"
            TotalCount="paged.TotalCount"
            PageChanged="OnPageChangedAsync" />

<EntityEditModal TItem="Flow"
                 @ref="flowModal"
                 Title="@modalTitle"
                 Item="editingFlow"
                 FormTemplate="FlowForm"
                 OnSave="SaveFlowAsync" />

@code {
    private List<EntityColumn<Flow>> flowColumns = [];
    private PagedResult<Flow> paged = new();
    private HashSet<string> SelectedIds = [];
    private List<Product> products = [];

    private EntityEditModal<Flow> flowModal = default!;
    private Flow editingFlow = new();
    private string modalTitle = "Новое движение";

    private string selectedProductId = string.Empty;
    private string? errorMessage;

    private int page = 1;
    private int pageSize = 20;
    private EntityColumn<Flow>? sortColumn;
    private bool sortAscending = true;

    private int TotalPages =>
        pageSize == 0 ? 0 : (int)Math.Ceiling(paged.TotalCount / (double)pageSize);

    protected override void OnInitialized()
    {
        flowColumns =
        [
            new EntityColumn<Flow>
            {
                Name = nameof(Flow.Date),
                Header = "Дата",
                Width = 3,
                ValueSelector = flow => flow.Date,
                CellTemplate = flow => @<span>@flow.Date.ToLocalTime().ToString("g")</span>
            },

            new EntityColumn<Flow>
            {
                Name = "Product",
                Header = "Товар",
                Width = 3,
                ValueSelector = flow => flow.ProductId,
                CellTemplate = flow => @<span>@GetProductName(flow.ProductId)</span>
            },

            new EntityColumn<Flow>
            {
                Name = nameof(Flow.QuantityIncome),
                Header = "Приход",
                Width = 2,
                ValueSelector = flow => flow.QuantityIncome,
                CellTemplate = flow => @<span>@flow.QuantityIncome</span>
            },

            new EntityColumn<Flow>
            {
                Name = nameof(Flow.QuantityOutcome),
                Header = "Расход",
                Width = 2,
                ValueSelector = flow => flow.QuantityOutcome,
                CellTemplate = flow => @<span>@flow.QuantityOutcome</span>
            },

            new EntityColumn<Flow>
            {
                Name = nameof(Flow.ReserveIncome),
                Header = "Резерв +",
                Width = 1,
                ValueSelector = flow => flow.ReserveIncome,
                CellTemplate = flow => @<span>@flow.ReserveIncome</span>
            },

            new EntityColumn<Flow>
            {
                Name = nameof(Flow.ReserveOutcome),
                Header = "Резерв -",
                Width = 1,
                ValueSelector = flow => flow.ReserveOutcome,
                CellTemplate = flow => @<span>@flow.ReserveOutcome</span>
            }
        ];
        sortColumn = flowColumns.First(x => x.Name == nameof(Flow.Date));
        sortAscending = false;
    }

    private string GetProductName(string productId)
    {
        return products.FirstOrDefault(x => x.Id == productId)?.Name ?? "—";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
        await LoadAsync();
    }

    private async Task LoadProductsAsync()
    {
        products = await Api.GetAll<Product>("api/products");
    }

    private RenderFragment<Flow> FlowForm => flow => @<div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Дата</label>
                <input class="form-control"
                       type="datetime-local"
                       @bind="flow.Date" />
            </div>

            <div class="col-md-6">
                <ProductSelect Products="products"
                               @bind-Value="flow.ProductId" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Приход, кол-во</label>
                <input class="form-control"
                       type="number"
                       @bind="flow.QuantityIncome" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Расход, кол-во</label>
                <input class="form-control"
                       type="number"
                       @bind="flow.QuantityOutcome" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Приход резерва</label>
                <input class="form-control"
                       type="number"
                       @bind="flow.ReserveIncome" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Расход резерва</label>
                <input class="form-control"
                       type="number"
                       @bind="flow.ReserveOutcome" />
            </div>
        </div>
    </div>;

    private async Task LoadAsync()
    {
        try
        {
            paged = await Api.GetPaged<Flow>(
                "api/flows",
                page,
                pageSize,
                selectedProductId,
                sortColumn.Name,
                sortAscending);

            SelectedIds = [];
            errorMessage = null;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Не удалось загрузить движения. Проверьте подключение к API.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task OnProductSelectedAsync(string productId)
    {
        selectedProductId = productId;
        page = 1;

        await LoadAsync();
    }

    private async Task OnSortChangedAsync(EntityColumn<Flow> column)
    {
        if (sortColumn?.Name == column.Name)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int newPage)
    {
        page = newPage;

        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        modalTitle = "Новое движение";
        editingFlow = new Flow();

        await flowModal.ShowAsync(editingFlow);
    }

    private async Task OpenEditAsync(Flow flow)
    {
        modalTitle = "Редактирование движения";

        editingFlow = new Flow
        {
            Id = flow.Id,
            Date = flow.Date,
            ProductId = flow.ProductId,
            QuantityIncome = flow.QuantityIncome,
            QuantityOutcome = flow.QuantityOutcome,
            ReserveIncome = flow.ReserveIncome,
            ReserveOutcome = flow.ReserveOutcome
        };

        await flowModal.ShowAsync(editingFlow);
    }

    private async Task SaveFlowAsync(Flow flow)
    {
        if (string.IsNullOrWhiteSpace(flow.ProductId))
        {
            throw new InvalidOperationException("ID товара обязательно.");
        }

        if (string.IsNullOrWhiteSpace(flow.Id))
        {
            await Api.Create("api/flows", flow);
        }
        else
        {
            await Api.Update("api/flows", flow.Id, flow);
        }

        await LoadAsync();
    }
}