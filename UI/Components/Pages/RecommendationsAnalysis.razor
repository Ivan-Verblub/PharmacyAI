@page "/"
@rendermode InteractiveServer
@using UI.Models
@using UI.Components.Shared
@using Periods = DataAPI.Models.PurchasePeriods
@inject ApiClient Api

<PageTitle>Анализ рекомендаций</PageTitle>

<h1>Анализ рекомендаций</h1>

<div class="d-flex align-items-center gap-3 flex-wrap mb-3">
    <span class="badge @(analysisStatus.HasRecommendations ? "badge-brand" : "bg-secondary")">
        @(analysisStatus.HasRecommendations
            ? "Рекомендации доступны"
            : "Рекомендации отсутствуют")
    </span>

    <span class="text-muted">
        Всего позиций: @analysisStatus.TotalCount
    </span>

    @if (analysisStatus.PurchaseFrom.HasValue && analysisStatus.PurchaseTo.HasValue)
    {
        <span class="text-muted">
            Последний расчёт: закупка на @analysisStatus.PurchaseFrom.Value.ToString("dd.MM.yyyy")–@analysisStatus.PurchaseTo.Value.ToString("dd.MM.yyyy")
            (@Periods.GetTitle(analysisStatus.PurchasePeriod).ToLowerInvariant())
            @if (analysisStatus.AnalysisFrom.HasValue && analysisStatus.AnalysisTo.HasValue)
            {
                <text>, история @analysisStatus.AnalysisFrom.Value.ToString("dd.MM.yyyy")–@analysisStatus.AnalysisTo.Value.ToString("dd.MM.yyyy")</text>
            }
        </span>
    }
</div>

<div class="card mb-4">
    <div class="card-header">Параметры анализа</div>

    <div class="card-body">
        <div class="row g-4">
            <div class="col-lg-3">
                <label class="form-label">Филиалы</label>

                <div class="branch-picker border rounded p-2">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="branch-all"
                               checked="@(selectedBranchIds.Count == 0)"
                               @onchange="() => selectedBranchIds.Clear()" />
                        <label class="form-check-label fw-medium" for="branch-all">Все активные</label>
                    </div>

                    @foreach (var branch in branches.Where(x => x.IsActive))
                    {
                        var id = $"branch-{branch.Id}";

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="@id"
                                   checked="@selectedBranchIds.Contains(branch.Id)"
                                   @onchange="args => ToggleBranch(branch.Id, args)" />
                            <label class="form-check-label" for="@id">@branch.Name</label>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <label class="form-label">Период анализа истории</label>

                <select class="form-select" @bind="historyMode">
                    @foreach (var days in HistoryPresets)
                    {
                        <option value="@days.ToString()">Последние @days дн.</option>
                    }
                    <option value="custom">Произвольный период</option>
                </select>

                @if (historyMode == "custom")
                {
                    <div class="row g-2 mt-1">
                        <div class="col-6">
                            <input class="form-control" type="date" @bind="analysisFrom" />
                        </div>
                        <div class="col-6">
                            <input class="form-control" type="date" @bind="analysisTo" />
                        </div>
                    </div>
                }

                <div class="form-text">
                    Спрос оценивается по движениям за @AnalysisRangeText.
                    По умолчанию: @settings.Analysis.HistoryDays дн. (меняется в настройках).
                </div>
            </div>

            <div class="col-lg-5">
                <label class="form-label">Период закупки</label>

                <div class="period-switch mb-2" role="group" aria-label="Период закупки">
                    @foreach (var (value, title) in PurchasePresets)
                    {
                        <button type="button"
                                class="btn btn-sm @(purchasePeriod == value ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => purchasePeriod = value">
                            @title
                        </button>
                    }
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1">Начало закупки</label>
                        <input class="form-control" type="date" @bind="purchaseFrom" />
                    </div>

                    @if (purchasePeriod == Periods.Custom)
                    {
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Окончание</label>
                            <input class="form-control" type="date" @bind="purchaseTo" />
                        </div>
                    }
                </div>

                <div class="form-text">
                    Потребность рассчитывается на @PurchaseRangeText.
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <Button Color="ButtonColor.Primary"
                    Disabled="@isAnalyzing"
                    @onclick="OpenAnalysisModalAsync">
                Анализировать
            </Button>
        </div>
    </div>
</div>

@if (analysisError is not null && !isAnalyzing)
{
    <div class="alert alert-danger">@analysisError</div>
}

<div class="card mb-4">
    <div class="card-header">Закупки в разрезе филиалов</div>

    <div class="card-body p-0">
        @if (branchSummary.Count == 0)
        {
            <div class="p-4 text-center text-muted">Рекомендаций пока нет</div>
        }
        else
        {
            <table class="table table-brand mb-0">
                <thead>
                    <tr>
                        <th>Филиал</th>
                        <th class="text-end">Позиций</th>
                        <th class="text-end">Расчётная потребность</th>
                        <th class="text-end">К закупке</th>
                        <th class="text-end">По обязательному минимуму</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in branchSummary)
                    {
                        <tr class="@(row.BranchId == selectedBranchId ? "table-active" : string.Empty)">
                            <td>@row.BranchName</td>
                            <td class="text-end">@row.Positions</td>
                            <td class="text-end">@row.CalculatedQuantity</td>
                            <td class="text-end fw-medium">@row.TotalQuantity</td>
                            <td class="text-end">@row.MinAppliedPositions</td>
                            <td class="text-end">
                                <button class="btn btn-link btn-sm p-0"
                                        @onclick="() => OnBranchSelectedAsync(row.BranchId)">
                                    Показать
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Итого</th>
                        <th class="text-end">@branchSummary.Sum(x => x.Positions)</th>
                        <th class="text-end">@branchSummary.Sum(x => x.CalculatedQuantity)</th>
                        <th class="text-end">@branchSummary.Sum(x => x.TotalQuantity)</th>
                        <th class="text-end">@branchSummary.Sum(x => x.MinAppliedPositions)</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
            <div class="small text-muted px-3 py-2">
                Количества суммируются в базовых единицах товаров.
            </div>
        }
    </div>
</div>

<div class="d-flex gap-3 flex-wrap align-items-end mb-3">
    <div style="min-width: 320px;">
        <ProductSelect Products="products"
                       Value="@selectedProductId"
                       ValueChanged="OnProductSelectedAsync" />
    </div>

    <div style="min-width: 220px;">
        <BranchSelect Branches="branches"
                      IncludeAll="true"
                      Value="@selectedBranchId"
                      ValueChanged="OnBranchSelectedAsync" />
    </div>

    @if (!string.IsNullOrWhiteSpace(selectedProductId) || !string.IsNullOrWhiteSpace(selectedBranchId))
    {
        <button class="btn btn-link" @onclick="ResetFiltersAsync">Сбросить фильтры</button>
    }
</div>

<EntityTable TItem="Recommendation"
             Items="paged.Items"
             Columns="recommendationColumns"
             KeySelector="x => x.Id"
             SelectedIds="SelectedIds"
             SortColumn="sortColumn"
             SortAscending="sortAscending"
             SortChanged="OnSortChangedAsync" />

<Pagination class="mt-3 justify-content-center"
            TotalPages="TotalPages"
            Page="page"
            PageSize="pageSize"
            TotalCount="paged.TotalCount"
            PageChanged="OnPageChangedAsync" />

<Modal @ref="analysisModal"
       Title="Анализ рекомендаций"
       Size="ModalSize.Regular">

    <BodyTemplate>
        <p>
            Выполняется анализ данных и подготовка рекомендаций по закупкам
            на @PurchaseRangeText.
        </p>

        <div class="progress"
             role="progressbar"
             aria-valuenow="@progress"
             aria-valuemin="0"
             aria-valuemax="100">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="width: @(progress)%;">
                @progress%
            </div>
        </div>
    </BodyTemplate>

</Modal>

@code {
    private static readonly int[] HistoryPresets = [30, 60, 90, 180, 365];

    private static readonly (string Value, string Title)[] PurchasePresets =
    [
        (Periods.Week, "Неделя"),
        (Periods.Month, "Месяц"),
        (Periods.Quarter, "Квартал"),
        (Periods.HalfYear, "Полгода"),
        (Periods.Year, "Год"),
        (Periods.Custom, "Свой период")
    ];

    private IntegrationSettings settings = new();

    private string historyMode = "90";
    private DateTime analysisFrom = DateTime.Today.AddDays(-89);
    private DateTime analysisTo = DateTime.Today;

    private string purchasePeriod = Periods.Month;
    private DateTime purchaseFrom = DateTime.Today;
    private DateTime purchaseTo = DateTime.Today.AddMonths(1).AddDays(-1);

    private HashSet<string> selectedBranchIds = [];

    private List<EntityColumn<Recommendation>> recommendationColumns = [];
    private PagedResult<Recommendation> paged = new();
    private HashSet<string> SelectedIds = [];

    private RecommendationAnalysisStatus analysisStatus = new();
    private List<BranchRecommendationSummary> branchSummary = [];

    private List<Product> products = [];
    private List<Branch> branches = [];
    private List<MeasureUnit> units = [];

    private string selectedProductId = string.Empty;
    private string selectedBranchId = string.Empty;

    private int page = 1;
    private int pageSize = 20;
    private EntityColumn<Recommendation>? sortColumn;
    private bool sortAscending = true;

    private Modal analysisModal = default!;
    private bool isAnalyzing;
    private int progress;
    private string? analysisError;

    private int TotalPages =>
        pageSize == 0 ? 0 : (int)Math.Ceiling(paged.TotalCount / (double)pageSize);

    private DateTime PurchaseEndExclusive =>
        Periods.GetEnd(purchaseFrom, purchasePeriod, purchaseTo);

    private string PurchaseRangeText
    {
        get
        {
            var end = PurchaseEndExclusive;
            var days = (end - purchaseFrom.Date).Days;

            return $"{purchaseFrom:dd.MM.yyyy}–{end.AddDays(-1):dd.MM.yyyy} ({days} дн.)";
        }
    }

    private string AnalysisRangeText
    {
        get
        {
            if (historyMode == "custom")
            {
                return $"{analysisFrom:dd.MM.yyyy}–{analysisTo:dd.MM.yyyy}";
            }

            var days = int.TryParse(historyMode, out var value) ? value : settings.Analysis.HistoryDays;

            return $"{DateTime.Today.AddDays(-days + 1):dd.MM.yyyy}–{DateTime.Today:dd.MM.yyyy}";
        }
    }

    protected override void OnInitialized()
    {
        recommendationColumns =
        [
            new EntityColumn<Recommendation>
            {
                Name = nameof(Recommendation.Date),
                Header = "Период закупки",
                Width = 2,
                ValueSelector = recommendation => recommendation.Date,
                CellTemplate = recommendation => @<span>@FormatPeriod(recommendation)</span>
            },

            new EntityColumn<Recommendation>
            {
                Name = "Product",
                Header = "Товар",
                Width = 3,
                ValueSelector = recommendation => recommendation.ProductId,
                CellTemplate = recommendation => @<span>@GetProductName(recommendation.ProductId)</span>
            },

            new EntityColumn<Recommendation>
            {
                Name = nameof(Recommendation.BranchId),
                Header = "Филиал",
                Width = 2,
                ValueSelector = recommendation => recommendation.BranchId,
                CellTemplate = recommendation => @<span>@GetBranchName(recommendation.BranchId)</span>
            },

            new EntityColumn<Recommendation>
            {
                Name = nameof(Recommendation.Quantity),
                Header = "К закупке",
                Width = 2,
                ValueSelector = recommendation => recommendation.Quantity,
                CellTemplate = recommendation => @<span title="Расчёт: @recommendation.CalculatedQuantity, обязательный минимум: @recommendation.MinPurchaseQuantity">
                    @FormatQuantity(recommendation)
                    @if (recommendation.MinPurchaseApplied)
                    {
                        <span class="badge badge-brand ms-1">мин.</span>
                    }
                </span>
            },

            new EntityColumn<Recommendation>
            {
                Name = nameof(Recommendation.Reason),
                Header = "Причина",
                Width = 3,
                ValueSelector = recommendation => recommendation.Reason,
                CellTemplate = recommendation => @<span title="@recommendation.Reason">@recommendation.Reason</span>
            }
        ];

        sortColumn = recommendationColumns.First(x => x.Name == nameof(Recommendation.Quantity));
        sortAscending = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await Api.GetSettingsAsync();

            historyMode = HistoryPresets.Contains(settings.Analysis.HistoryDays)
                ? settings.Analysis.HistoryDays.ToString()
                : "custom";

            analysisFrom = DateTime.Today.AddDays(-settings.Analysis.HistoryDays + 1);
            analysisTo = DateTime.Today;

            if (!string.IsNullOrWhiteSpace(settings.Analysis.DefaultPurchasePeriod))
            {
                purchasePeriod = settings.Analysis.DefaultPurchasePeriod;
            }

            products = await Api.GetAll<Product>("api/products");
            branches = await Api.GetAll<Branch>("api/branches");
            units = await Api.GetAll<MeasureUnit>("api/units");

            await LoadAnalysisStatusAsync();
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            analysisError = "Не удалось загрузить данные. Проверьте подключение к API.";
            Console.Error.WriteLine(ex);
        }
    }

    private void ToggleBranch(string branchId, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            selectedBranchIds.Add(branchId);
        }
        else
        {
            selectedBranchIds.Remove(branchId);
        }
    }

    private string GetProductName(string productId)
    {
        return products.FirstOrDefault(x => x.Id == productId)?.Name ?? "—";
    }

    private string GetBranchName(string branchId)
    {
        return branches.FirstOrDefault(x => x.Id == branchId)?.Name ?? "—";
    }

    private string GetUnitName(string? unitId)
    {
        return units.FirstOrDefault(x => x.Id == unitId)?.DisplayName ?? "шт.";
    }

    private string FormatQuantity(Recommendation recommendation)
    {
        var product = products.FirstOrDefault(x => x.Id == recommendation.ProductId);
        var text = $"{recommendation.Quantity} {GetUnitName(product?.UnitId)}";

        if (product is not null && product.PurchaseUnitRatio > 1)
        {
            var packs = recommendation.PurchaseUnitQuantity > 0
                ? recommendation.PurchaseUnitQuantity
                : (int)Math.Ceiling(recommendation.Quantity / (double)product.PurchaseUnitRatio);

            text += $" ({packs} {GetUnitName(product.PurchaseUnitId ?? product.UnitId)})";
        }

        return text;
    }

    private static string FormatPeriod(Recommendation recommendation)
    {
        return recommendation.PurchaseFrom.HasValue && recommendation.PurchaseTo.HasValue
            ? $"{recommendation.PurchaseFrom:dd.MM.yy}–{recommendation.PurchaseTo:dd.MM.yy}"
            : recommendation.Date.ToLocalTime().ToString("d");
    }

    private async Task LoadAnalysisStatusAsync()
    {
        analysisStatus = await Api.GetAnalysisStatusAsync();
        branchSummary = await Api.GetBranchSummaryAsync();
    }

    private async Task LoadAsync()
    {
        paged = await Api.GetPaged<Recommendation>(
            "api/recommendations",
            page,
            pageSize,
            selectedProductId,
            sortColumn?.Name,
            !sortAscending,
            selectedBranchId);

        SelectedIds = [];
    }

    private async Task OnProductSelectedAsync(string productId)
    {
        selectedProductId = productId;
        page = 1;

        await LoadAsync();
    }

    private async Task OnBranchSelectedAsync(string branchId)
    {
        selectedBranchId = branchId;
        page = 1;

        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        selectedProductId = string.Empty;
        selectedBranchId = string.Empty;
        page = 1;

        await LoadAsync();
    }

    private async Task OnSortChangedAsync(EntityColumn<Recommendation> column)
    {
        if (sortColumn?.Name == column.Name)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int newPage)
    {
        page = newPage;

        await LoadAsync();
    }

    private RecommendationAnalysisRequest BuildRequest()
    {
        var request = new RecommendationAnalysisRequest
        {
            TargetDate = purchaseFrom.Date,
            PurchasePeriod = purchasePeriod,
            PurchaseTo = purchasePeriod == Periods.Custom ? purchaseTo.Date : null,
            BranchIds = [.. selectedBranchIds]
        };

        if (historyMode == "custom")
        {
            request.AnalysisFrom = analysisFrom.Date;
            request.AnalysisTo = analysisTo.Date;
        }
        else if (int.TryParse(historyMode, out var days))
        {
            request.HistoryDays = days;
        }

        return request;
    }

    private string? ValidateRequest()
    {
        if (purchaseFrom.Date < DateTime.Today)
        {
            return "Начало периода закупки не может быть в прошлом.";
        }

        if (purchasePeriod == Periods.Custom && purchaseTo.Date < purchaseFrom.Date)
        {
            return "Окончание периода закупки раньше начала.";
        }

        if (historyMode == "custom" && analysisFrom.Date > analysisTo.Date)
        {
            return "Начало периода анализа позже окончания.";
        }

        return null;
    }

    private async Task OpenAnalysisModalAsync()
    {
        analysisError = ValidateRequest();

        if (analysisError is not null)
        {
            return;
        }

        progress = 0;
        isAnalyzing = true;

        await analysisModal.ShowAsync();

        using var cts = new CancellationTokenSource();
        var progressTask = AnimateProgressAsync(cts.Token);

        try
        {
            await Api.AnalyzeAsync(BuildRequest());

            cts.Cancel();
            progress = 100;
            StateHasChanged();

            page = 1;
            await LoadAnalysisStatusAsync();
            await LoadAsync();

            await Task.Delay(400);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            analysisError = ex is HttpRequestException && !string.IsNullOrWhiteSpace(ex.Message)
                ? $"Не удалось выполнить анализ: {ex.Message}"
                : "Не удалось выполнить анализ. Проверьте доступность сервиса рекомендаций.";

            Console.Error.WriteLine(ex);
        }
        finally
        {
            cts.Cancel();

            try
            {
                await progressTask;
            }
            catch (OperationCanceledException)
            {
            }

            isAnalyzing = false;

            await analysisModal.HideAsync();
        }
    }

    /// <summary>
    /// Индикация ожидания: анализ выполняется одним запросом к API,
    /// поэтому прогресс плавно растёт до 90% и завершается по ответу.
    /// </summary>
    private async Task AnimateProgressAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested && progress < 90)
        {
            await Task.Delay(700, cancellationToken);

            progress = Math.Min(90, progress + Math.Max(1, (90 - progress) / 8));

            await InvokeAsync(StateHasChanged);
        }
    }
}
